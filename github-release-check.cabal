cabal-version:   3.4
name:            github-release-check
version:         0.1.0.0
synopsis:        GitHub release update banner for Haskell CLIs
description:
  Check the GitHub Releases API for a newer version of a CLI and print
  an update banner to a caller-supplied sink. The library is rate-limited
  by an on-disk cache (separate timers for GitHub hits and banner prints),
  silent on network failure, and opt-out friendly. Designed to be wired
  into a CLI's @main@ via 'withUpdateCheck' so the banner prints after
  the command finishes.

license:         Apache-2.0
license-file:    LICENSE
author:          Paolo Veronelli
maintainer:      paolo.veronelli@gmail.com
copyright:       (c) Paolo Veronelli, 2026
homepage:        https://github.com/lambdasistemi/github-release-check
bug-reports:
  https://github.com/lambdasistemi/github-release-check/issues

category:        System
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

flag werror
  description: Enable -Werror
  manual:      True
  default:     False

common warnings
  ghc-options:
    -Wall -Wunused-imports -Wmissing-export-lists -Wname-shadowing
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

  default-extensions:
    DerivingStrategies
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StrictData

library
  import:           warnings
  hs-source-dirs:   lib
  default-language: GHC2021
  exposed-modules:
    GitHub.Release.Check
    GitHub.Release.Check.Cache
    GitHub.Release.Check.Decision
    GitHub.Release.Check.Fetcher

  build-depends:
    , aeson            >=2.2  && <2.3
    , base             >=4.18 && <5
    , bytestring       >=0.11 && <0.13
    , directory        >=1.3  && <1.4
    , filepath         >=1.4  && <1.6
    , http-client      >=0.7  && <0.8
    , http-client-tls  >=0.3  && <0.4
    , http-types       >=0.12 && <0.13
    , text             >=2.0  && <2.2
    , time             >=1.12 && <1.15

-- Canary executable: wires the library against the library's own
-- GitHub repo. The point is integration coverage — exercise the full
-- IO path (cache file, fetcher, decision, banner sink) end-to-end on
-- every build, so a regression in any of those layers fails CI here
-- before downstream consumers pull a broken pin.
executable github-release-check-canary
  import:           warnings
  hs-source-dirs:   app/canary
  main-is:          Main.hs
  default-language: GHC2021
  autogen-modules:  Paths_github_release_check
  other-modules:    Paths_github_release_check
  build-depends:
    , base
    , github-release-check
    , text

  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite unit-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  default-language:   GHC2021
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    GitHub.Release.Check.CacheSpec
    GitHub.Release.Check.DecisionSpec

  build-depends:
    , aeson
    , base
    , bytestring
    , directory
    , filepath
    , github-release-check
    , hspec                 >=2.11 && <2.12
    , QuickCheck            >=2.14 && <2.16
    , temporary             >=1.3  && <1.4
    , text
    , time
